{
  "name": "yarnspinner-typescript",
  "version": "1.0.0",
  "private": false,
  "description": "TypeScript parser, compiler, and runtime for Yarn Spinner 3.x [NPM package](https://www.npmjs.com/package/yarnspinner-typescript)",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennymaeleidig/yarnspinner-typescript.git"
  },
  "homepage": "https://github.com/jennymaeleidig/yarnspinner-typescript#readme",
  "bugs": {
    "url": "https://github.com/jennymaeleidig/yarnspinner-typescript/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/postprocess-cjs.mjs",
    "build:all": "npm run build && npm run build:cjs && npm run build -w yarnspinner-vite-plugin",
    "clean": "rimraf dist",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc -p tsconfig.json",
    "pretest": "npm run format:check && npm run build:all",
    "test": "node scripts/run-tests.js",
    "prepublishOnly": "npm run build:all",
    "demo": "vite --config examples/browser/vite.config.ts --host 0.0.0.0",
    "demo:build": "vite build --config examples/browser/vite.config.ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/compile/nodeProjectFs.d.ts",
        "default": "./dist/compile/nodeProjectFs.js"
      },
      "require": {
        "types": "./dist/compile/nodeProjectFs.d.cts",
        "default": "./dist/compile/nodeProjectFs.cjs"
      }
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "dist/compile",
    "dist/markup",
    "dist/model",
    "dist/parse",
    "dist/runtime",
    "dist/scene",
    "README.md"
  ],
  "keywords": [
    "yarn-spinner",
    "dialogue",
    "parser",
    "compiler"
  ],
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  }
}
